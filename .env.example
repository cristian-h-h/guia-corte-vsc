# Ejemplo de archivo .env para configurar las variables de entorno de Supabase
# Copia este archivo a .env y completa los valores

# URL de tu proyecto Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima de tu proyecto Supabase
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-muy-larga

# Pixels de publicidad (opcional). Si se dejan vacios, no se cargan.
# Pixel de Meta / Instagram
VITE_META_PIXEL_ID=
# Pixel de TikTok
VITE_TIKTOK_PIXEL_ID=